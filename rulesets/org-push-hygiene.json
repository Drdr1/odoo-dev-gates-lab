{
  "name": "org: no environment files, keys, dumps or large files",
  "target": "push",
  "enforcement": "active",
  "bypass_actors": [],
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": { "restricted_file_paths": [".env", "**/.env", ".env.*", "**/.env.*", "android/**", "ios/**"] }
    },
    {
      "type": "file_extension_restriction",
      "parameters": { "restricted_file_extensions": ["*.pem", "*.key", "*.p12", "*.pfx", "*.jks", "*.keystore", "*.sql", "*.dump", "*.bak"] }
    },
    { "type": "max_file_size", "parameters": { "max_file_size": 10 } }
  ]
}
